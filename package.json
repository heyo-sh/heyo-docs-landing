{
  "name": "heyo-docs-landing",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "pretypecheck": "bun run cf-typegen",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "format-staged": "lint-staged",
    "prepare": "husky",
    "knip": "knip --include files,dependencies,unlisted,unresolved",
    "cf-typegen": "wrangler types",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@mdx-js/mdx": "3.1.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@react-router/node": "8.3.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "@heyo-sh/heyo-docs": "0.1.0",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@tailwindcss/vite": "^4.1.14",
    "@react-router/dev": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "wrangler": "4.125.0"
  },
  "lint-staged": {
    "*.{astro,cjs,css,cts,html,js,json,jsonc,jsx,md,mdx,mjs,mts,ts,tsx,yaml,yml}": "prettier --write"
  }
}
